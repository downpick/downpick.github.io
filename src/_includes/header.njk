<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a class="brand" href="/">
      <img src="/assets/downpick-mark.svg" alt="" width="104" height="122">
      <span>{{ site.name }}</span>
    </a>
    <div class="nav-links">
      {%- for item in site.nav %}
      {%- if item.key == navKey %}
      <span class="nav-current" aria-current="page">{{ item.label | safe }}</span>
      {%- else %}
      <a class="nav-link" href="{{ item.href }}">{{ item.label | safe }}</a>
      {%- endif %}
      {%- endfor %}
      <a class="nav-link nav-link--github" href="{{ site.repo }}">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.28.83 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        GitHub
      </a>
      {%- if site.navCta.key == navKey %}
      <span class="nav-current" aria-current="page">{{ site.navCta.label | safe }}</span>
      {%- else %}
      <a class="btn btn--accent btn--sm" href="{{ site.navCta.href }}">{{ site.navCta.label | safe }}</a>
      {%- endif %}
    </div>
  </nav>
</header>
